<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 转存 + 重命名需要网络 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Wi-Fi 高性能锁：任务期间防止射频休眠导致请求超时 -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- 前台服务：批量转存/改名耗时任务 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 自更新：下载 APK 后拉起系统安装器（Android 8+ 还需用户在设置里允许「安装未知应用」） -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 普通权限，不弹窗：仅调试入口（wakeScreen extra）用来点亮屏幕，方便真机截屏回归 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 仅 Android 9 及以下保存打赏二维码到相册需要；Android 10+ 走 MediaStore 免权限 -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- allowBackup=false：凭证存在 EncryptedSharedPreferences，Keystore 密钥不随云备份迁移，
         换机恢复后旧密文无法解密（会崩或凭证永久失效），因此关闭系统云备份 -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CloudSaver">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 从系统分享菜单/其他 App 打开分享链接 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="www.guangyapan.com" />
                <data android:scheme="https" android:host="pan.quark.cn" />
                <data android:scheme="https" android:host="drive.quark.cn" />
            </intent-filter>
        </activity>

        <!-- 任务执行前台服务：熄屏/切后台/划掉最近任务都不中断；
             stopWithTask=false 保证「从最近任务划掉」不会顺手把服务停掉 -->
        <service
            android:name=".sync.TaskRunService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:stopWithTask="false" />

        <!-- 自更新：把 filesDir/update 下的 APK 以 content:// 交给系统安装器
             （targetSdk ≥ 30 传 file:// 会 FileUriExposedException，用户看到「解析包错误」） -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
